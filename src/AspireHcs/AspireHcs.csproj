<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <PackageId>AspireHcs</PackageId>
    <Version>0.1.0</Version>
    <Description>Experimental Aspire hosting integration for the Windows Host Compute System (HCS): Hyper-V virtual machines and Hyper-V-isolated Windows containers as Aspire resources, both driven through the hcsctl CLI, which must be installed separately. Windows-only by design; fails fast elsewhere.</Description>
    <PackageTags>aspire;hosting;hyper-v;hcs;virtual-machine;windows;windows-containers</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="AspireHcs.Tests" />
    <InternalsVisibleTo Include="AspireHcs.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      No CsWin32, and no P/Invoke of any kind. Everything that touches HCS, HNS or VirtDisk goes
      through the hcsctl child process now (hcsctl#30). If a native call looks necessary here, the
      surface it needs belongs in hcsctl instead.
    -->
    <PackageReference Include="Aspire.Hosting" />
  </ItemGroup>

</Project>
