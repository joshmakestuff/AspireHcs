<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AspireHcs\AspireHcs.csproj" />
    <ProjectReference Include="..\..\samples\HcsSample.AppHost\HcsSample.AppHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Shared with the unit test project rather than duplicated: both need to resolve the same
      hcsctl, and two copies of that rule would drift into testing two different binaries.
    -->
    <Compile Include="..\AspireHcs.Tests\RepositoryTools.cs" Link="RepositoryTools.cs" />
  </ItemGroup>

</Project>
